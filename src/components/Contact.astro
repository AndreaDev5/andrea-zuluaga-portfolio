---
import { site } from '../data/site';
import Reveal from './Reveal.tsx';
import Icon from './Icon.astro';

const channels = [
  { name: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'mail' },
  { name: 'LinkedIn', value: 'in/andrea-zuluaga-monroy', href: site.linkedin, icon: 'linkedin' },
  { name: 'GitHub', value: '@AndreaDev5', href: site.github, icon: 'github' },
];
---
<section id="contact" class="border-t border-border py-20 sm:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <Reveal client:visible>
        <span class="eyebrow mb-4" data-i18n="contact_eyebrow">Contacto</span>
        <h2 class="section-title" data-i18n="contact_title">Hablemos</h2>
        <p class="mt-4 max-w-md text-muted" data-i18n="contact_intro">
          ¿Tienes un proyecto de datos, automatización o IA en mente? Escríbeme y conversemos.
        </p>

        <ul class="mt-8 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.icon === 'mail' ? undefined : '_blank'}
                rel="noopener noreferrer"
                class="card-surface flex items-center gap-4 p-4 hover:-translate-y-0.5 hover:border-accent/60"
              >
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
                  <Icon name={c.icon} size={18} />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-ink">{c.name}</span>
                  <span class="block truncate text-sm text-muted">{c.value}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>

    <div class="lg:col-span-7 lg:mt-12">
      <Reveal client:visible delay={0.1}>
        <form
          id="contact-form"
          action="https://formsubmit.co/ajax/andreazuluagamonroy05@gmail.com"
          method="POST"
          class="card-surface p-6 sm:p-8"
        >
          <!-- Config FormSubmit -->
          <input type="hidden" name="_subject" value="Nuevo mensaje desde tu portafolio ✨" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <!-- Honeypot anti-spam (invisible) -->
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <label for="name" class="mb-2 block text-sm font-medium text-ink" data-i18n="contact_label_name">Nombre</label>
              <input
                id="name" name="name" type="text" required
                class="w-full rounded-xl border border-border bg-bg px-4 py-3 text-sm text-ink placeholder:text-muted/70 focus:border-accent"
                placeholder="Tu nombre" data-i18n-ph="contact_ph_name"
              />
            </div>
            <div class="sm:col-span-1">
              <label for="email" class="mb-2 block text-sm font-medium text-ink" data-i18n="contact_label_email">Email</label>
              <input
                id="email" name="email" type="email" required
                class="w-full rounded-xl border border-border bg-bg px-4 py-3 text-sm text-ink placeholder:text-muted/70 focus:border-accent"
                placeholder="tu@email.com" data-i18n-ph="contact_ph_email"
              />
            </div>
          </div>
          <div class="mt-5">
            <label for="message" class="mb-2 block text-sm font-medium text-ink" data-i18n="contact_label_message">Mensaje</label>
            <textarea
              id="message" name="message" rows="5" required
              class="w-full resize-y rounded-xl border border-border bg-bg px-4 py-3 text-sm text-ink placeholder:text-muted/70 focus:border-accent"
              placeholder="Cuéntame sobre tu proyecto…" data-i18n-ph="contact_ph_message"
            ></textarea>
          </div>
          <div class="mt-6 flex items-center justify-between gap-4">
            <button type="submit" class="btn-primary">
              <span data-i18n="contact_btn">Enviar mensaje</span>
              <Icon name="arrow-right" size={18} />
            </button>
            <p id="form-status" class="text-sm text-muted" aria-live="polite"></p>
          </div>
        </form>
      </Reveal>
    </div>
  </div>
</section>

<script is:inline>
  // Envío directo vía FormSubmit (AJAX): el mensaje llega al correo de Andrea
  // sin que el visitante salga de la página. Muestra estado en pantalla.
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const MSG = {
    es: {
      sending: 'Enviando…',
      sent: '¡Mensaje enviado! Gracias, te responderé pronto. ✅',
      error: 'No se pudo enviar. Escríbeme directo a mi correo.',
    },
    en: {
      sending: 'Sending…',
      sent: "Message sent! Thanks, I'll get back to you soon. ✅",
      error: 'Could not send. Please email me directly.',
    },
  };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const m = MSG[document.documentElement.lang === 'en' ? 'en' : 'es'];
    const btn = form.querySelector('button[type="submit"]');
    status.textContent = m.sending;
    status.className = 'text-sm text-muted';
    if (btn) btn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const json = await res.json().catch(() => ({}));
      if (res.ok && String(json.success) === 'true') {
        status.textContent = m.sent;
        status.className = 'text-sm text-accent';
        form.reset();
      } else {
        status.textContent = json.message || m.error;
        status.className = 'text-sm text-muted';
      }
    } catch (err) {
      status.textContent = m.error;
      status.className = 'text-sm text-muted';
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
