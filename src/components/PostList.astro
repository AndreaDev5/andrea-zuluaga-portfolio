---
import Icon from './Icon.astro';
import PostArt from './PostArt.astro';
import { postUrl, url, type BlogPost } from '../lib/blog';

interface Props {
  posts: BlogPost[];
}
const { posts } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<div>
  {posts.map((post, i) => {
    // Zigzag: par → texto izquierda / ilustración derecha. Impar → al revés.
    const textoIzq = i % 2 === 0;
    return (
      <article class="post-zig">
        <div class="zig-body">
          <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
            <!-- Texto -->
            <div class={textoIzq ? 'lg:order-1' : 'lg:order-2'}>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <span class="mono-meta zig-index text-accent-2/80">{pad(i + 1)}</span>
                {post.data.series && post.data.seriesOrder && (
                  <span class="mono-meta rounded border border-border bg-surface px-2 py-0.5">
                    <span data-i18n="blog_part">serie · parte</span> {pad(post.data.seriesOrder)}
                  </span>
                )}
                {post.data.draft && (
                  <span class="mono-meta rounded border border-accent/40 px-2 py-0.5 text-accent-2" data-i18n="blog_draft">
                    borrador
                  </span>
                )}
              </div>

              <h3 class="mt-5 text-2xl font-semibold leading-snug tracking-tight text-ink sm:text-3xl">
                {post.data.title}
              </h3>

              <p class="mt-4 text-sm leading-relaxed text-muted sm:text-base">
                {post.data.excerpt}
              </p>

              {post.data.tags.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1">
                  {post.data.tags.map((tag) => <li class="mono-meta">#{tag}</li>)}
                </ul>
              )}

              <a href={postUrl(post.slug)} class="zig-cta mt-7 text-sm font-medium text-ink">
                <span data-i18n="blog_read">Leer artículo</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </div>

            <!-- Ilustración -->
            <div class={textoIzq ? 'lg:order-2' : 'lg:order-1'}>
              {post.data.cover ? (
                <figure class="art-frame overflow-hidden rounded-2xl border border-border">
                  <img
                    src={url(post.data.cover)}
                    alt={post.data.coverAlt ?? post.data.title}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </figure>
              ) : post.data.art ? (
                <PostArt art={post.data.art} />
              ) : null}
            </div>
          </div>
        </div>
      </article>
    );
  })}
</div>
