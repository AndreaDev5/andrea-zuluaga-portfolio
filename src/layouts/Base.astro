---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${site.name} — Data Analytics, AI Solutions & Process Automation`, description = site.description } = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(`${base}og.jpg`.replace(/\/+/g, '/'), Astro.site ?? site.url).href;
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Pre-paint: aplica el tema guardado antes de pintar (sin flash). Dark por default. -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'light' ? 'light' : 'dark';
        document.documentElement.classList.remove('light', 'dark');
        document.documentElement.classList.add(theme);
      })();
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content="Data Analytics, AI Solutions, Process Automation, FinOps, Power BI, SQL, Python, AI Agents, KPI, Andrea Zuluaga" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#121519" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD: Persona -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      jobTitle: 'Data Analytics | AI Solutions | Process Automation',
      description: site.description,
      url: site.url,
      email: site.email,
      sameAs: [site.linkedin, site.github],
    })} />
  </head>
  <body>
    <slot />

    <script>
      import { dict } from '../data/i18n';

      const KEY = 'lang';
      const getLang = () => (localStorage.getItem(KEY) === 'en' ? 'en' : 'es');

      // Evita que la reaplicación se dispare a sí misma en bucle
      let aplicando = false;

      function applyLang(lang) {
        if (aplicando) return;
        aplicando = true;

        const d = dict[lang] || dict.es;
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const k = el.getAttribute('data-i18n');
          // Solo escribimos si cambió: menos mutaciones y menos repintados
          if (k && d[k] != null && el.innerHTML !== d[k]) el.innerHTML = d[k];
        });
        document.querySelectorAll('[data-i18n-ph]').forEach((el) => {
          const k = el.getAttribute('data-i18n-ph');
          if (k && d[k] != null) el.setAttribute('placeholder', d[k]);
        });
        document.querySelectorAll('[data-i18n-aria]').forEach((el) => {
          const k = el.getAttribute('data-i18n-aria');
          if (k && d[k] != null) el.setAttribute('aria-label', d[k]);
        });
        document.documentElement.lang = lang;
        const lbl = document.getElementById('lang-label');
        if (lbl) lbl.textContent = lang.toUpperCase();
        localStorage.setItem(KEY, lang);
        window.__lang = lang;

        // Se libera en el siguiente macrotask, cuando ya se procesaron las
        // mutaciones que acabamos de provocar (así el observer no se retroalimenta).
        setTimeout(() => { aplicando = false; }, 0);
      }

      applyLang(getLang());

      // Los bloques animados son islands de React: al hidratarse (o al animarse)
      // pueden volver a pintar su contenido original en español. Reaplicamos el
      // idioma cuando eso ocurra para que la traducción no se pierda.
      window.addEventListener('load', () => applyLang(getLang()));

      const observer = new MutationObserver(() => applyLang(getLang()));
      observer.observe(document.body, { childList: true, subtree: true });

      document.getElementById('lang-toggle')?.addEventListener('click', () => {
        applyLang(getLang() === 'es' ? 'en' : 'es');
      });
    </script>
  </body>
</html>
